---
// Section 04 — Projects
// Learning through projects. Editorial archive, not a trophy wall.
import { projects } from '../../data/projects';
---

<section 
  id="projects" 
  class="relative py-28 sm:py-36 lg:py-44 px-6 sm:px-10 lg:px-16 border-b border-brand-border/30 bg-brand-black"
>
  <div class="max-w-[1400px] mx-auto">
    
    <!-- Section label -->
    <div class="font-mono text-[10px] text-neutral-500 tracking-widest uppercase mb-6 reveal-on-scroll">
      04 — Selected Projects
    </div>

    <!-- Section heading -->
    <div class="mb-20 lg:mb-28 reveal-on-scroll">
      <h2 class="text-editorial-hero text-white max-w-4xl">
        Learning through projects.
      </h2>
      <p class="font-sans font-light text-neutral-400 text-sm sm:text-base mt-6 max-w-lg">
        Each project below represents a period of learning. Not a trophy — a conversation that changed how I see branding.
      </p>
    </div>

    <!-- Project archive — Editorial asymmetric layout -->
    <div class="space-y-0">
      {projects.map((project, i) => (
        <a 
          href={`/projects/${project.slug}`}
          class={`
            group block grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-10 
            py-12 sm:py-16 lg:py-20 
            border-t border-brand-border/40 
            ${i === projects.length - 1 ? 'border-b' : ''} 
            hover:bg-brand-surface/30 transition-all duration-300 
            -mx-6 sm:-mx-10 lg:-mx-16 px-6 sm:px-10 lg:px-16
            reveal-on-scroll
          `}
        >
          <!-- Image -->
          <div class={`lg:col-span-5 ${i % 2 === 1 ? 'lg:order-2' : ''}`}>
            <div class="relative aspect-[16/10] overflow-hidden bg-brand-surface border border-brand-border/30">
              <img 
                src={project.image} 
                alt={project.title}
                class="w-full h-full object-cover img-monochrome group-hover:scale-[1.04] transition-transform duration-700"
                loading="lazy"
              />
            </div>
          </div>

          <!-- Content -->
          <div class={`lg:col-span-7 flex flex-col justify-center ${i % 2 === 1 ? 'lg:order-1' : ''}`}>
            
            <!-- Meta row -->
            <div class="flex items-center gap-4 mb-4">
              <span class="font-mono text-[11px] text-neutral-500 tracking-wider">No. {String(i + 1).padStart(2, '0')}</span>
              <span class="w-6 h-px bg-neutral-600"></span>
              <span class="font-mono text-[11px] text-neutral-500 tracking-wider">{project.category}</span>
              <span class="font-mono text-[11px] text-neutral-600 tracking-wider ml-auto">{project.year}</span>
            </div>

            <!-- Title -->
            <h3 class="font-display text-3xl sm:text-4xl lg:text-5xl text-white font-medium tracking-tight mb-4 group-hover:text-neutral-200 transition-colors">
              {project.title}
            </h3>

            <!-- Subtitle -->
            <p class="font-sans font-light text-neutral-400 text-sm sm:text-base leading-relaxed max-w-xl mb-6">
              {project.subtitle}
            </p>

            <!-- Deliverables -->
            <div class="flex flex-wrap gap-x-4 gap-y-1">
              {project.deliverables.slice(0, 3).map(d => (
                <span class="font-mono text-[10px] text-neutral-500 uppercase tracking-widest">{d}</span>
              ))}
            </div>

            <!-- Read link -->
            <div class="mt-6">
              <span class="inline-flex items-center gap-2 text-[12px] font-mono uppercase tracking-widest text-neutral-500 group-hover:text-white transition-colors duration-200">
                <span>Read study</span>
                <span class="transition-transform duration-200 group-hover:translate-x-1">→</span>
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
