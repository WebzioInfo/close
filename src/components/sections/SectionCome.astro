---
// Section 01 — Opening
// Concept: Come. Quiet confidence. Curiosity before explanation.
---

<section 
  id="come" 
  class="relative min-h-[92vh] lg:min-h-screen flex flex-col justify-between px-6 sm:px-10 lg:px-16 py-16 sm:py-20 border-b border-brand-border/30 bg-brand-black"
>
  <!-- Top bar -->
  <div class="relative z-10 flex items-center justify-between font-mono text-[10px] text-neutral-500 tracking-widest uppercase">
    <span>Close — Branding Practice</span>
    <span class="hidden sm:block">Calicut, Kerala</span>
  </div>

  <!-- Center: Monumental Display -->
  <div class="relative z-10 max-w-6xl my-auto py-20 lg:py-28 w-full">
    
    <h1 class="text-monumental text-white mb-14 max-w-5xl reveal-on-scroll">
      Come closer.
    </h1>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-end">
      <div class="lg:col-span-7 space-y-5">
        <p class="font-display text-xl sm:text-2xl lg:text-3xl text-neutral-200 leading-snug font-medium max-w-2xl tracking-tight reveal-on-scroll">
          Observe how this practice thinks before it creates.
        </p>
        <p class="font-sans font-light text-sm sm:text-base text-neutral-400 leading-relaxed max-w-lg reveal-on-scroll">
          Close is where observation becomes identity. A quiet studio for branding, strategy, and thoughtful communication.
        </p>
      </div>

      <div class="lg:col-span-5 flex lg:justify-end reveal-on-scroll">
        <a 
          href="#learner"
          class="group inline-flex items-center gap-3 text-[12px] font-mono uppercase tracking-widest text-neutral-400 hover:text-white transition-colors duration-200 border-b border-neutral-700 hover:border-white pb-2"
        >
          <span>Explore</span>
          <span class="transition-transform duration-300 group-hover:translate-y-0.5">↓</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="relative z-10 flex items-center justify-between font-mono text-[10px] text-neutral-500 tracking-widest uppercase border-t border-brand-border/20 pt-6">
    <span>Learning &middot; Observing &middot; Practicing</span>
    <span class="hidden sm:block">Est. Calicut</span>
  </div>
</section>
