---
// Section 01 — Opening
// WHITE hero. Supporting text top-left, heading bottom-right, whitespace between.
---

<section 
  id="come" 
  class="relative bg-white overflow-hidden"
  style="min-height: calc(100vh - 5rem);"
>
  <div class="relative px-6 sm:px-10 lg:px-16 flex flex-col justify-between" style="min-height: calc(100vh - 5rem);">

    <!-- 01 — Supporting text: top-left -->
    <div class="max-w-[1400px] mx-auto w-full pt-12 sm:pt-16 lg:pt-20 hero-intro">
      <p class="font-sans text-[13px] text-neutral-500 font-normal leading-relaxed max-w-[260px]">
        A practice of learning, observing, and looking closer.
      </p>
    </div>

    <!-- 02 — Main heading: bottom-right -->
    <div class="max-w-[1400px] mx-auto w-full pb-12 sm:pb-16 lg:pb-20 hero-statement">
      <h1 class="font-display font-semibold text-brand-black hero-headline lg:text-right">
        Learning to look beyond what a brand looks like.
      </h1>
    </div>

  </div>
</section>

<style>
  .hero-headline {
    font-size: clamp(2.2rem, 5.2vw, 5.8rem);
    line-height: 1.08;
    letter-spacing: -0.025em;
    font-style: normal;
  }

  .hero-intro {
    opacity: 0;
    transform: translateY(12px);
    animation: heroSettle 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.25s forwards;
  }

  .hero-statement {
    opacity: 0;
    transform: translateY(16px);
    animation: heroSettle 1s cubic-bezier(0.16, 1, 0.3, 1) 0.45s forwards;
  }

  @keyframes heroSettle {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 1023px) {
    .hero-headline {
      text-align: left;
    }
  }

  @media (max-width: 639px) {
    .hero-headline {
      font-size: clamp(1.85rem, 8vw, 2.6rem);
      line-height: 1.12;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-intro,
    .hero-statement {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>
