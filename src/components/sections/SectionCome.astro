---
// Section 01 — Opening
// WHITE hero. Supporting text top-left, heading bottom-right, whitespace between.
// Editorial Sequence (LOOK / FEEL / REMEMBER) in middle space + Masked Brand Reveal Choreography
---

<section
  id="come"
  class="relative min-h-[100svh] w-full bg-white overflow-hidden flex flex-col justify-between"
>
  <div
    class="relative w-full h-full px-6 sm:px-10 lg:px-16 flex flex-col justify-between flex-grow"
    style="min-height: 100svh;"
  >
    <!-- 01 — Top Row: Supporting text (left) + Logo Signature (right) -->
    <div
      class="max-w-[1400px] mx-auto w-full pt-12 sm:pt-16 lg:pt-36 lg:mt-20 flex flex-col sm:flex-row justify-between items-start gap-8 hero-intro"
    >
      <p
        class="font-sans text-[23px] text-neutral-500 font-normal leading-[1.55] max-w-[480px]"
      >
        A practice of learning, observing, and looking closer — exploring what
        makes brands meaningful, memorable, and felt beyond what they look like.
      </p>

      <!-- Top-Right: Close Communications Logo Signature -->
      <div class="sm:self-start lg:pr-2 shrink-0">
        <img
          src="/logo.png"
          alt="Close Communications Logo"
          class="w-[140px] sm:w-[160px] lg:w-[380px] h-auto object-contain mix-blend-multiply opacity-90"
        />
      </div>
    </div>

    <!-- Middle: Editorial Sequence (LOOK / FEEL / REMEMBER) -->

    <!-- 02 — Main heading: bottom-right -->
    <div
      class="max-w-[1400px] mx-auto w-full pb-12 sm:pb-16 lg:pb-20 hero-statement"
    >
      <h1
        class="font-display font-semibold text-brand-black hero-headline lg:text-right"
      >
        <span class="sm:block">Learning to look beyond what a</span>
        <span class="sm:block mt-1 sm:mt-0">
          <span class="brand-mask-container">
            <span class="brand-word">brand</span>
          </span>
          <span class="looks-like-word">looks like.</span>
        </span>
      </h1>
    </div>
  </div>
</section>

<style>
  .hero-headline {
    font-size: clamp(2.2rem, 5.2vw, 5.8rem);
    line-height: 1.08;
    letter-spacing: -0.025em;
    font-style: normal;
  }

  .hero-intro {
    opacity: 0;
    transform: translateY(12px);
    animation: heroSettle 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.05s forwards;
  }

  .hero-statement {
    opacity: 0;
    transform: translateY(16px);
    animation: heroSettle 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.1s forwards;
  }

  @keyframes heroSettle {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ——— Editorial Sequence (LOOK / FEEL / REMEMBER) ——— */
  .observation-field {
    opacity: 0;
    transform: translateY(8px);
    animation: heroSettle 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.15s forwards;
  }

  .step-word {
    opacity: 0.5;
    transition: opacity 0.5s ease;
  }

  .step-look {
    animation: wordHighlight 0.6s ease 0.2s forwards;
  }
  .step-feel {
    animation: wordHighlight 0.6s ease 0.5s forwards;
  }
  .step-remember {
    animation: wordHighlightRemember 0.6s ease 0.8s forwards;
  }

  @keyframes wordHighlight {
    0% {
      opacity: 0.4;
    }
    50% {
      opacity: 1;
      color: #171717;
    }
    100% {
      opacity: 0.7;
      color: #525252;
    }
  }

  @keyframes wordHighlightRemember {
    0% {
      opacity: 0.4;
    }
    50% {
      opacity: 1;
    }
    100% {
      opacity: 0.95;
    }
  }

  /* ——— Masked Brand Emergence Choreography ——— */
  .brand-mask-container {
    display: inline-block;
    vertical-align: bottom;
    overflow: hidden;
    line-height: 1.1;
    margin-bottom: -0.12em;
    padding-bottom: 0.12em;
  }

  .brand-word {
    display: inline-block;
    vertical-align: baseline;
    color: #7a263a; /* Muted oxblood accent */
    /* Hidden behind the mask boundary during 0-1000ms hold */
    transform: translateY(115%);
    animation: brandEmerge 0.8s cubic-bezier(0.16, 1, 0.3, 1) 1s forwards;
    will-change: transform;
  }

  .looks-like-word {
    display: inline-block;
    vertical-align: baseline;
    opacity: 1;
    margin-left: 0.28em; /* Normal word spacing */
    transform: translateX(-48px);
    animation: looksLikeShiftRight 0.8s cubic-bezier(0.16, 1, 0.3, 1) 1s
      forwards;
    will-change: transform;
  }

  @keyframes brandEmerge {
    0% {
      transform: translateY(115%);
    }
    100% {
      transform: translateY(0);
    }
  }

  @keyframes looksLikeShiftRight {
    0% {
      transform: translateX(-48px);
    }
    100% {
      transform: translateX(0);
    }
  }

  @media (max-width: 1023px) {
    .hero-headline {
      text-align: left;
    }
  }

  @media (max-width: 639px) {
    .hero-headline {
      font-size: clamp(1.85rem, 8vw, 2.6rem);
      line-height: 1.12;
    }

    .brand-word {
      transform: translateY(115%);
      animation: brandEmerge 0.8s cubic-bezier(0.16, 1, 0.3, 1) 1s forwards;
    }

    .looks-like-word {
      margin-left: 0.25em;
      transform: translateX(-28px);
      animation: looksLikeShiftRightMobile 0.8s cubic-bezier(0.16, 1, 0.3, 1) 1s
        forwards;
    }
  }

  @keyframes looksLikeShiftRightMobile {
    0% {
      transform: translateX(-28px);
    }
    100% {
      transform: translateX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-intro,
    .hero-statement,
    .observation-field,
    .looks-like-word {
      opacity: 1;
      transform: none;
      animation: none;
    }
    .step-word {
      opacity: 1;
      animation: none;
    }
    .brand-mask-container {
      overflow: visible;
    }
    .brand-word {
      opacity: 1;
      transform: none;
      color: #7a263a;
      animation: none;
    }
  }
</style>
