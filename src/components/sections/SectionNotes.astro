---
// Section 05 — Notes
// Editorial index. Thoughts, observations, conversations.
import { notes } from '../../data/notes';
---

<section 
  id="notes" 
  class="relative py-28 sm:py-36 lg:py-44 px-6 sm:px-10 lg:px-16 bg-brand-nearblack border-b border-brand-border/30"
>
  <div class="max-w-[1400px] mx-auto">
    
    <!-- Section label -->
    <div class="font-mono text-[10px] text-neutral-500 tracking-widest uppercase mb-6 reveal-on-scroll">
      05 — Notes
    </div>

    <!-- Section heading -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-16 lg:mb-24 reveal-on-scroll">
      <div class="lg:col-span-7">
        <h2 class="text-editorial-heading text-white">
          Thoughts, observations, conversations.
        </h2>
      </div>
      <div class="lg:col-span-5 flex lg:items-end lg:justify-end">
        <p class="font-sans font-light text-neutral-400 text-sm max-w-sm">
          A running index of essays, field notes, and observations from the practice.
        </p>
      </div>
    </div>

    <!-- Notes index — editorial list -->
    <div class="space-y-0">
      {notes.map((note, i) => (
        <a 
          href={`/notes/${note.slug}`}
          class={`
            group block py-8 sm:py-10 
            border-t border-brand-border/40 
            ${i === notes.length - 1 ? 'border-b' : ''} 
            hover:bg-brand-surface/30 transition-all duration-200 
            -mx-6 sm:-mx-10 lg:-mx-16 px-6 sm:px-10 lg:px-16
            reveal-on-scroll
          `}
        >
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-3 lg:gap-8 items-start lg:items-center">
            
            <!-- Date + Category -->
            <div class="lg:col-span-3 flex items-center gap-3">
              <span class="font-mono text-[11px] text-neutral-500 tracking-wider whitespace-nowrap">{note.date}</span>
              <span class="hidden lg:block w-4 h-px bg-neutral-600"></span>
              <span class="font-mono text-[10px] text-neutral-600 uppercase tracking-widest">{note.category}</span>
            </div>

            <!-- Title -->
            <div class="lg:col-span-6">
              <h3 class="font-display text-lg sm:text-xl lg:text-2xl text-white font-medium tracking-tight group-hover:text-neutral-200 transition-colors leading-snug">
                {note.title}
              </h3>
              <p class="font-sans text-xs sm:text-sm text-neutral-500 mt-2 line-clamp-1 max-w-lg group-hover:text-neutral-400 transition-colors">
                {note.excerpt}
              </p>
            </div>

            <!-- Read time + Arrow -->
            <div class="lg:col-span-3 flex items-center justify-between lg:justify-end gap-4">
              <span class="font-mono text-[10px] text-neutral-600 tracking-wider">{note.readTime}</span>
              <span class="text-neutral-600 group-hover:text-white transition-all duration-200 group-hover:translate-x-1">→</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
