---
// Section 06 — The Office
// Contact. Arriving at the studio. Personal, not corporate.
---

<section 
  id="office" 
  class="relative py-28 sm:py-36 lg:py-44 px-6 sm:px-10 lg:px-16 bg-brand-black"
>
  <div class="max-w-[1400px] mx-auto">
    
    <!-- Section label -->
    <div class="font-mono text-[10px] text-neutral-500 tracking-widest uppercase mb-6 reveal-on-scroll">
      06 — The Office
    </div>

    <!-- Two-column layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-24 items-start">
      
      <!-- Left: Invitation -->
      <div class="lg:col-span-7 space-y-10 reveal-on-scroll">
        
        <h2 class="text-editorial-hero text-white max-w-xl">
          Begin a conversation.
        </h2>

        <p class="font-sans font-light text-neutral-400 text-base sm:text-lg leading-relaxed max-w-lg">
          Close is a personal practice — not a firm. Every conversation begins directly with the practitioner. No account managers, no forms, no automated responses.
        </p>

        <p class="font-sans font-light text-neutral-400 text-base leading-relaxed max-w-lg">
          If you are a founder, studio, agency, or organization with a branding challenge that requires genuine attention — I would like to hear from you.
        </p>

        <!-- Contact details -->
        <div class="space-y-6 pt-6 border-t border-brand-border/30">
          
          <div>
            <span class="font-mono text-[10px] text-neutral-500 uppercase tracking-widest block mb-2">Email</span>
            <a href="mailto:hello@closecommunications.com" class="font-display text-lg sm:text-xl text-white font-medium hover:text-neutral-300 transition-colors">
              hello@closecommunications.com
            </a>
          </div>

          <div>
            <span class="font-mono text-[10px] text-neutral-500 uppercase tracking-widest block mb-2">Location</span>
            <span class="font-sans text-neutral-300 text-sm">Calicut (Kozhikode), Kerala, India</span>
          </div>

          <div>
            <span class="font-mono text-[10px] text-neutral-500 uppercase tracking-widest block mb-2">Availability</span>
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-white/70 animate-slow-pulse"></span>
              <span class="font-sans text-neutral-300 text-sm">Accepting select projects for 2025–2026</span>
            </div>
          </div>
        </div>

        <!-- Social -->
        <div class="flex items-center gap-6 pt-6">
          <a href="#" class="font-mono text-[11px] text-neutral-500 hover:text-white transition-colors uppercase tracking-widest">Instagram</a>
          <a href="#" class="font-mono text-[11px] text-neutral-500 hover:text-white transition-colors uppercase tracking-widest">LinkedIn</a>
          <a href="#" class="font-mono text-[11px] text-neutral-500 hover:text-white transition-colors uppercase tracking-widest">Are.na</a>
        </div>
      </div>

      <!-- Right: Studio image -->
      <div class="lg:col-span-5 reveal-on-scroll">
        <div class="relative aspect-[3/4] overflow-hidden bg-brand-surface border border-brand-border/40 group">
          <img 
            src="https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=1200&q=80" 
            alt="Minimal studio workspace"
            class="w-full h-full object-cover img-monochrome group-hover:scale-[1.03] transition-transform duration-700"
            loading="lazy"
          />
          <div class="absolute bottom-0 inset-x-0 p-4 bg-brand-black/80 font-mono text-[10px] text-neutral-400 flex justify-between">
            <span>The office</span>
            <span>Calicut</span>
          </div>
        </div>

        <!-- Quiet sign-off -->
        <div class="mt-8 border-l-2 border-brand-border/50 pl-5">
          <p class="font-display text-lg text-neutral-300 font-medium leading-snug">
            "Every meaningful brand began with a conversation, not a contract."
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
