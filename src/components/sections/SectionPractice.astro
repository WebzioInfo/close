---
// Section 03 — The Practice
// Where learning becomes practice. Observation → Strategy → Identity → Communication.
const disciplines = [
  {
    number: '01',
    title: 'Observation',
    description: 'Immersion in context. Understanding the environment, audience, and culture before forming any creative response.',
  },
  {
    number: '02',
    title: 'Brand Strategy',
    description: 'Translating observations into clear positioning, narrative frameworks, and strategic foundations for lasting identities.',
  },
  {
    number: '03',
    title: 'Identity Design',
    description: 'Crafting visual systems — marks, typography, color, language — that embody the strategy with precision and character.',
  },
  {
    number: '04',
    title: 'Creative Direction',
    description: 'Overseeing the full arc of a project: from concept to execution, ensuring coherence across every touchpoint.',
  },
  {
    number: '05',
    title: 'Communication',
    description: 'Articulating brands through language, editorial, and storytelling that resonates with people who actually listen.',
  },
];
---

<section 
  id="practice" 
  class="relative min-h-[100svh] w-full py-14 sm:py-16 lg:py-20 px-6 sm:px-10 lg:px-16 bg-brand-nearblack border-b border-brand-border/30 flex flex-col justify-center overflow-hidden"
>
  <div class="max-w-[1400px] mx-auto w-full my-auto">
    
    <!-- Section label -->
    <div class="font-mono text-[10px] text-neutral-500 tracking-widest uppercase mb-4 sm:mb-6 reveal-on-scroll">
      03 — The Practice
    </div>

    <!-- Section heading -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 mb-10 sm:mb-14 lg:mb-16 reveal-on-scroll">
      <div class="lg:col-span-8">
        <h2 class="text-editorial-hero text-white">
          Where learning becomes practice.
        </h2>
      </div>
      <div class="lg:col-span-4 flex lg:items-end">
        <p class="font-sans font-light text-neutral-400 text-xs sm:text-sm leading-relaxed">
          Close works across five interconnected disciplines. Each project moves through all of them — never as checkboxes, always as an evolving conversation.
        </p>
      </div>
    </div>

    <!-- Disciplines list — editorial, not cards -->
    <div class="space-y-0">
      {disciplines.map((discipline, i) => (
        <div 
          class={`
            group grid grid-cols-1 lg:grid-cols-12 gap-2 lg:gap-8 py-5 sm:py-6 lg:py-7
            border-t border-brand-border/40 
            ${i === disciplines.length - 1 ? 'border-b' : ''} 
            hover:bg-brand-surface/50 transition-colors duration-300 -mx-6 sm:-mx-10 lg:-mx-16 px-6 sm:px-10 lg:px-16
            reveal-on-scroll
          `}
        >
          <!-- Number -->
          <div class="lg:col-span-1">
            <span class="font-mono text-[11px] text-neutral-500 tracking-wider">{discipline.number}</span>
          </div>

          <!-- Title -->
          <div class="lg:col-span-4">
            <h3 class="font-display text-2xl sm:text-3xl lg:text-4xl text-white font-medium tracking-tight group-hover:text-neutral-100 transition-colors">
              {discipline.title}
            </h3>
          </div>

          <!-- Description -->
          <div class="lg:col-span-6">
            <p class="font-sans font-light text-neutral-400 text-sm sm:text-base leading-relaxed max-w-xl group-hover:text-neutral-300 transition-colors">
              {discipline.description}
            </p>
          </div>

          <!-- Arrow indicator -->
          <div class="lg:col-span-1 flex lg:justify-end lg:items-center">
            <span class="text-neutral-600 group-hover:text-white transition-all duration-200 group-hover:translate-x-1 text-lg">→</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Closing editorial note -->
    <div class="mt-8 sm:mt-12 lg:mt-14 max-w-xl reveal-on-scroll">
      <p class="font-display text-lg sm:text-xl lg:text-2xl text-neutral-300 font-medium leading-snug">
        Practice does not mean repetition.
        It means continuing to pay attention.
      </p>
    </div>
  </div>
</section>
