---
const navLinks = [
  { label: "Learner", href: "/#learner", id: "learner" },
  { label: "Practice", href: "/#practice", id: "practice" },
  { label: "Projects", href: "/#projects", id: "projects" },
  { label: "Notes", href: "/#notes", id: "notes" },
  { label: "Office", href: "/#office", id: "office" },
];
---

<header
  class="fixed top-0 inset-x-0 z-50 pointer-events-none w-full pt-3 sm:pt-5 px-4 sm:px-8 lg:px-12 transition-all duration-300"
>
  <div
    class="max-w-[1400px] mx-auto bg-white border border-neutral-200/90 shadow-[0_4px_24px_rgba(0,0,0,0.06)] rounded-full h-12 sm:h-14 px-4 sm:px-6 flex items-center justify-between pointer-events-auto transition-all duration-300"
  >
    <!-- Left: Close Wordmark Signature -->
    <a
      href="/"
      class="group flex items-center gap-2 focus:outline-none focus:ring-2 focus:ring-black/20 rounded-full transition-opacity hover:opacity-80 shrink-0"
      aria-label="Close — Home"
    >
      <span
        class="font-display text-xs sm:text-sm font-semibold tracking-tight text-neutral-900 leading-none uppercase"
      >
        CLOSE COMMUNICATIONS
      </span>
    </a>

    <!-- Center: Desktop Navigation -->
    <nav
      class="hidden md:flex items-center gap-1"
      aria-label="Main Navigation"
    >
      {
        navLinks.map((link, i) => (
          <a
            href={link.href}
            data-nav-id={link.id}
            class={`nav-pill-item text-[13px] font-sans font-medium rounded-full px-3.5 py-1.5 transition-all duration-200 ${i === 0 ? "is-active" : "text-neutral-700 hover:text-black hover:bg-neutral-100/70"}`}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <!-- Center: Mobile Navigation -->
    <nav
      class="flex md:hidden items-center gap-0.5 max-w-[160px] overflow-x-auto scrollbar-none"
      aria-label="Mobile Navigation"
    >
      {
        navLinks.map((link, i) => (
          <a
            href={link.href}
            data-nav-id={link.id}
            class={`nav-pill-item text-[11px] font-sans font-medium whitespace-nowrap rounded-full px-2.5 py-1 transition-all duration-200 ${i === 0 ? "is-active" : "text-neutral-700 hover:text-black"}`}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <!-- Right: Location Indicator -->
    <div
      class="flex items-center gap-2 font-mono text-[11px] text-neutral-600 uppercase tracking-wider shrink-0"
    >
      <span class="w-1.5 h-1.5 rounded-full bg-neutral-900 animate-slow-pulse"
      ></span>
      <span class="hidden sm:inline">Calicut</span>
    </div>
  </div>
</header>

<style>
  .nav-pill-item.is-active {
    background-color: #0d0d0d !important;
    color: #ffffff !important;
    font-weight: 500;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
  }

  /* Hide scrollbar for mobile nav */
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-none {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script>
  const setupNavObserver = () => {
    const navItems = document.querySelectorAll(".nav-pill-item");
    if (!navItems.length) return;

    const sections = ["learner", "practice", "projects", "notes", "office"]
      .map((id) => document.getElementById(id))
      .filter(Boolean);

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.id;
            navItems.forEach((item) => {
              if (item.getAttribute("data-nav-id") === id) {
                item.classList.add("is-active");
              } else {
                item.classList.remove("is-active");
              }
            });
          }
        });
      },
      { threshold: 0.25, rootMargin: "-10% 0px -50% 0px" },
    );

    sections.forEach((section) => observer.observe(section!));
  };

  document.addEventListener("astro:page-load", setupNavObserver);
  document.addEventListener("DOMContentLoaded", setupNavObserver);
</script>
