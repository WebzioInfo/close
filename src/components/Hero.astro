---
// Hero.astro — Cinematic Scroll-Driven Experience
// Matching the client poster layout:
// 1. Hero (right-aligned)
// 2. Services grid (2x2, left-aligned within each cell)
// 3. brandhing (right-aligned)
// 4. Contact (left-aligned)
// 5. Footer (wordmark left, two blocks center-right)
---

<div class="scroll-drive">
  <div class="cinema-viewport">

    <!-- Subtle Parallax Depth Lines -->
    <div class="parallax-grid" aria-hidden="true">
      <span class="grid-line gl-1"></span>
      <span class="grid-line gl-2"></span>
      <span class="grid-line gl-3"></span>
    </div>

    <!-- Scroll hint indicator on initial frame -->
    <div class="scroll-hint" id="scrollHint">
      <div class="scroll-hint-line"></div>
    </div>

    <!-- ─── SECTION 1: HERO (RIGHT-ALIGNED) ─── -->
    <div class="scene scene-1" id="scene1" aria-label="Hero Section">
      <div class="scene-container">
        <div class="hero-content">
          <h1 class="hero-headline" id="s1Headline">
            <span class="hero-line hero-line-come" id="heroComeLine">
              <span class="hero-word-flip hero-word-come" id="hwCome">come,</span>
            </span>
            <span class="hero-line hero-line-close" id="heroCloseLine">
              <span class="hero-word-flip hero-word-close" id="hwClose">Close is open.</span>
            </span>
          </h1>
          <p class="hero-subtext" id="s1Subtext">
            While our new home is getting ready here,<br />
            we're doing what we always love to do,<br />
            working closely with businesses and agencies.
          </p>
        </div>
      </div>
    </div>

    <!-- ─── SECTION 2: SERVICES GRID (2x2, LEFT-ALIGNED WITHIN CELLS) ─── -->
    <div class="scene scene-2" id="scene2" aria-label="Services Section">
      <div class="scene-container">
        <div class="services-grid" id="s2Grid" role="region" aria-label="Our Services">
          
          <!-- Top-Left: Business Design -->
          <div class="service-card" tabindex="0">
            <h2 class="service-title">
              Business<br />Design.
            </h2>
            <p class="service-desc">
              Designing the flow<br class="hidden sm:inline" />
              of money and memories
            </p>
          </div>

          <!-- Top-Right: Brand Development -->
          <div class="service-card" tabindex="0">
            <h2 class="service-title">
              Brand<br />Development.
            </h2>
            <p class="service-desc">
              what and why Matters.<br class="hidden sm:inline" />
              learning from people, Thinking for people.
            </p>
          </div>

          <!-- Bottom-Left: Creative Direction -->
          <div class="service-card" tabindex="0">
            <h2 class="service-title">
              Creative<br />Direction.
            </h2>
            <p class="service-desc">
              The clarity and creativity,<br class="hidden sm:inline" />
              connecting logic with magic,
            </p>
          </div>

          <!-- Bottom-Right: Brainstorm with Brandlearner -->
          <div class="service-card" tabindex="0">
            <h2 class="service-title">
              Brainstorm<br />with Brandlearner
            </h2>
            <p class="service-desc">
              Time and Thoughts matter.<br class="hidden sm:inline" />
              Fine Creative and Relevant Solutions
            </p>
          </div>

        </div>
      </div>
    </div>

    <!-- ─── SECTION 3: BRANDHING (RIGHT-ALIGNED) ─── -->
    <div class="scene scene-3" id="scene3" aria-label="Brandhing Section">
      <div class="scene-container">
        <div class="brandhing-content">
          <h2 class="brandhing-headline" id="s3Headline">
            "brandhing"
          </h2>
          <div class="brandhing-body" id="s3Body">
            <p class="brandhing-lead">
              Brandlearner is learning you, madly.
            </p>
            <p class="brandhing-para">
              Observing people, businesses, cultures, and everyday life to understand how businesses and services find a place in people's minds. A lifelong curiosity about what makes something remembered, trusted, felt, and eventually called a brand.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- ─── SECTION 4: CONTACT (LEFT-ALIGNED) ─── -->
    <div class="scene scene-4" id="scene4" aria-label="Contact Section">
      <div class="scene-container">
        <div class="contact-content">
          <div class="contact-links" id="s4Links">
            <a href="tel:+918714448195" class="contact-entry" aria-label="Call +91 871 444 8195">
              +91 871 444 8195
            </a>
            <a href="mailto:mailtoclose@gmail.com" class="contact-entry" aria-label="Email mailtoclose@gmail.com">
              mailtoclose@gmail.com
            </a>
          </div>
          <p class="contact-sub" id="s4Sub">
            Let's learn about branding,
          </p>
        </div>
      </div>
    </div>

    <!-- ─── SECTION 5: FOOTER (WORDMARK LEFT, TWO BLOCKS CENTER-RIGHT) ─── -->
    <div class="scene scene-5" id="scene5" aria-label="Footer Section">
      <div class="scene-container">
        <footer class="footer-layout">
          
          <!-- Left: CLOSE Logo Wordmark -->
          <div class="footer-brand" id="s5Logo">
            <span class="close-wordmark">CLOSE</span>
          </div>

          <!-- Center-Right: Two Italic Text Blocks -->
          <div class="footer-details" id="s5Blocks">
            <div class="footer-col">
              <p class="footer-text">
                A home for branding practices<br />
                <span class="footer-highlight">by Brandlearner</span>
              </p>
            </div>
            <div class="footer-col">
              <p class="footer-text">
                Search us in people's minds<br />
                <span class="footer-dimmed">&copy; Close Communications</span>
              </p>
            </div>
          </div>

        </footer>
      </div>
    </div>

  </div>
</div>

<style>
  /* ── Continuous Scroll Drive ── */
  .scroll-drive {
    position: relative;
    height: 520vh;
    width: 100%;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .scroll-drive::-webkit-scrollbar {
    display: none;
  }

  :global(html),
  :global(body) {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  :global(html::-webkit-scrollbar),
  :global(body::-webkit-scrollbar) {
    display: none;
  }

  /* ── Fixed Cinema Viewport ── */
  .cinema-viewport {
    position: fixed;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 1;
  }

  /* ── Background Subtle Lines ── */
  .parallax-grid {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }
  .grid-line {
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: rgba(255, 255, 255, 0.03);
    will-change: transform;
  }
  .gl-1 { top: 25%; }
  .gl-2 { top: 50%; }
  .gl-3 { top: 75%; }

  /* ── Standardized Scene Frame (Exact Alignment Margin) ── */
  .scene {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 1.25rem;
    will-change: transform, opacity;
    z-index: 1;
    pointer-events: none;
  }
  @media (min-width: 640px) {
    .scene {
      padding: 0 2rem;
    }
  }
  @media (min-width: 1024px) {
    .scene {
      padding: 0 3.5rem;
    }
  }

  .scene-container {
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
    position: relative;
    pointer-events: auto;
  }

  /* Initial Scene Opacities */
  .scene-1 { opacity: 1; pointer-events: auto; }
  .scene-2,
  .scene-3,
  .scene-4,
  .scene-5 { opacity: 0; pointer-events: none; }

  /* ══════════════════════════════════════════
     SECTION 1: HERO (RIGHT-ALIGNED)
     ══════════════════════════════════════════ */
  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
    width: 100%;
  }

  .hero-headline {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    font-weight: 700;
    font-size: clamp(38px, 8.5vw, 106px);
    line-height: 0.98;
    letter-spacing: -0.04em;
    color: #ffffff;
    margin: 0;
    padding: 0;
    perspective: 1200px;
    perspective-origin: 75% 20%;
    transform-style: preserve-3d;
    will-change: transform, opacity;
  }

  .hero-line {
    display: block;
  }

  .hero-line-come,
  .hero-line-close {
    display: block;
    overflow: visible;
    transform-style: preserve-3d;
  }

  .hero-word-flip {
    display: inline-block;
    will-change: transform, opacity;
    transform-origin: 75% 0%;
    transform-style: preserve-3d;
    backface-visibility: hidden;
    transform: translate3d(0, 0, 0);
    opacity: 1;
  }

  .hero-word-come {
    transform-origin: 75% 0%;
  }

  .hero-word-close {
    transform-origin: 75% 0%;
  }

  .hero-subtext {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    font-style: italic;
    font-weight: 400;
    font-size: clamp(14px, 1.8vw, 22px);
    line-height: 1.55;
    letter-spacing: -0.01em;
    color: rgba(255, 255, 255, 0.92);
    margin-top: 1.75rem;
    max-width: 580px;
    will-change: transform, opacity;
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  /* ══════════════════════════════════════════
     SECTION 2: SERVICES GRID (2x2, LEFT-ALIGNED)
     ══════════════════════════════════════════ */
  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.2rem 1.75rem;
    width: 100%;
    max-width: 980px;
    margin: 0 auto;
    will-change: transform, opacity;
  }

  @media (min-width: 540px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 3.25rem 3rem;
    }
  }

  @media (min-width: 1024px) {
    .services-grid {
      gap: 4.25rem 5rem;
    }
  }

  .service-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    outline: none;
    border-radius: 8px;
    padding: 0.5rem 0.25rem;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.25s ease;
  }

  .service-card:hover,
  .service-card:focus-visible {
    transform: translateY(-2px);
  }

  .service-card:focus-visible {
    outline: 1px solid rgba(255, 255, 255, 0.4);
    outline-offset: 4px;
  }

  .service-title {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    font-weight: 700;
    font-size: clamp(22px, 3.2vw, 42px);
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin: 0;
  }

  .service-desc {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    font-style: italic;
    font-weight: 400;
    font-size: clamp(12.5px, 1.25vw, 17px);
    line-height: 1.5;
    letter-spacing: -0.01em;
    color: rgba(255, 255, 255, 0.82);
    margin-top: 0.75rem;
  }

  /* ══════════════════════════════════════════
     SECTION 3: BRANDHING (RIGHT-ALIGNED)
     ══════════════════════════════════════════ */
  .brandhing-content {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
    width: 100%;
  }

  .brandhing-headline {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    font-weight: 700;
    font-size: clamp(44px, 9.5vw, 115px);
    line-height: 0.95;
    letter-spacing: -0.04em;
    color: #ffffff;
    text-transform: lowercase;
    margin: 0 0 1.5rem 0;
    will-change: transform, opacity;
  }

  .brandhing-body {
    max-width: 660px;
    width: 100%;
    will-change: transform, opacity;
  }

  .brandhing-lead {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    font-weight: 700;
    font-style: italic;
    font-size: clamp(14px, 1.5vw, 20px);
    line-height: 1.55;
    letter-spacing: -0.01em;
    color: #ffffff;
    margin: 0 0 0.5rem 0;
  }

  .brandhing-para {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    font-style: italic;
    font-weight: 400;
    font-size: clamp(13px, 1.45vw, 18.5px);
    line-height: 1.62;
    letter-spacing: -0.01em;
    color: rgba(255, 255, 255, 0.9);
    margin: 0;
  }

  /* ══════════════════════════════════════════
     SECTION 4: CONTACT (LEFT-ALIGNED)
     ══════════════════════════════════════════ */
  .contact-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    width: 100%;
  }

  .contact-links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
    will-change: transform, opacity;
  }

  .contact-entry {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    font-weight: 700;
    font-size: clamp(22px, 4.4vw, 56px);
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: #ffffff;
    text-decoration: none;
    display: inline-block;
    transition: color 0.2s ease, opacity 0.2s ease;
  }

  .contact-entry:hover,
  .contact-entry:focus-visible {
    color: rgba(255, 255, 255, 0.75);
    outline: none;
  }

  .contact-sub {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    font-style: italic;
    font-weight: 400;
    font-size: clamp(13px, 1.45vw, 19px);
    line-height: 1.5;
    letter-spacing: -0.01em;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 1.35rem;
    will-change: transform, opacity;
  }

  /* ══════════════════════════════════════════
     SECTION 5: FOOTER (WORDMARK + TWO BLOCKS IN BALANCED ROW)
     ══════════════════════════════════════════ */
  .footer-layout {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    width: 100%;
  }

  @media (min-width: 768px) {
    .footer-layout {
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
      gap: clamp(1.75rem, 3.2vw, 3.5rem);
    }
  }

  .footer-brand {
    display: flex;
    align-items: center;
    line-height: 1;
    will-change: transform, opacity;
  }

  .close-wordmark {
    font-family: 'Syncopate', sans-serif;
    font-weight: 700;
    font-size: clamp(32px, 5vw, 64px);
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #ffffff;
    display: inline-block;
  }

  .footer-details {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    will-change: transform, opacity;
  }

  @media (min-width: 600px) {
    .footer-details {
      flex-direction: row;
      align-items: center;
      gap: clamp(1.75rem, 3.2vw, 3.5rem);
    }
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .footer-text {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    font-style: italic;
    font-weight: 400;
    font-size: clamp(12px, 1.15vw, 15px);
    line-height: 1.5;
    letter-spacing: -0.01em;
    color: rgba(255, 255, 255, 0.9);
    margin: 0;
  }

  .footer-highlight {
    color: #ffffff;
  }

  .footer-dimmed {
    color: rgba(255, 255, 255, 0.65);
  }

  /* ── Scroll Hint Indicator ── */
  .scroll-hint {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 5;
    pointer-events: none;
  }
  .scroll-hint-line {
    width: 1px;
    height: 44px;
    background: linear-gradient(to bottom, transparent, rgba(255,255,255,0.4), transparent);
    animation: hintPulse 2.4s ease-in-out infinite;
  }
  @keyframes hintPulse {
    0%, 100% { opacity: 0.15; transform: scaleY(0.4); }
    50%      { opacity: 0.65; transform: scaleY(1); }
  }

  /* ── Reduced Motion Fallback: Continuous Static Poster Flow ── */
  @media (prefers-reduced-motion: reduce) {
    .scroll-drive { height: auto !important; }
    .cinema-viewport {
      position: relative !important;
      pointer-events: auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6rem;
      padding: 5rem 1rem 4rem 1rem;
    }
    .scene {
      position: relative !important;
      opacity: 1 !important;
      transform: none !important;
      inset: auto;
      padding: 1.5rem 0;
      pointer-events: auto !important;
    }
    .hero-headline, .hero-subtext, .hero-word-flip, .hero-word-come, .hero-word-close,
    .services-grid, .brandhing-headline, .brandhing-body,
    .contact-links, .contact-sub,
    .footer-brand, .footer-details {
      opacity: 1 !important;
      transform: none !important;
      -webkit-clip-path: none !important;
      clip-path: none !important;
      animation: none !important;
    }
    .scroll-hint, .parallax-grid { display: none; }
  }
</style>

<script>
  // ═══════════════════════════════════════════════════════
  //  FLUID CINEMATIC SCROLL ENGINE
  //  • C2-continuous Smootherstep easing (zero velocity / zero jerk)
  //  • Time-stabilized weighted lerp damping
  //  • Precise 5-scene cinematic sequencing
  // ═══════════════════════════════════════════════════════

  const rmq = window.matchMedia('(prefers-reduced-motion: reduce)');

  function initScrollEngine() {
    if (rmq.matches) return;

    const drive       = document.querySelector('.scroll-drive') as HTMLElement | null;
    const scene1      = document.getElementById('scene1');
    const s1Headline  = document.getElementById('s1Headline');
    const hwCome      = document.getElementById('hwCome');
    const hwClose     = document.getElementById('hwClose');
    const s1Subtext   = document.getElementById('s1Subtext');

    const scene2      = document.getElementById('scene2');
    const s2Grid      = document.getElementById('s2Grid');

    const scene3      = document.getElementById('scene3');
    const s3Headline  = document.getElementById('s3Headline');
    const s3Body      = document.getElementById('s3Body');

    const scene4      = document.getElementById('scene4');
    const s4Links     = document.getElementById('s4Links');
    const s4Sub       = document.getElementById('s4Sub');

    const scene5      = document.getElementById('scene5');
    const s5Logo      = document.getElementById('s5Logo');
    const s5Blocks    = document.getElementById('s5Blocks');

    const hint        = document.getElementById('scrollHint');
    const gridLines   = document.querySelectorAll('.grid-line') as NodeListOf<HTMLElement>;

    if (!drive || !scene1 || !scene2 || !scene3 || !scene4 || !scene5) return;

    let cur  = 0;
    let tgt  = 0;
    let busy = false;
    let lastTime = 0;
    const DAMP_RATE = 5.2; // Time-constant for buttery weighted damping

    // Math & Continuous Easing Utilities
    const clamp = (v: number, lo: number, hi: number) => v < lo ? lo : v > hi ? hi : v;
    const remap = (v: number, a: number, b: number) => clamp((v - a) / (b - a), 0, 1);
    const lerp  = (a: number, b: number, t: number) => a + (b - a) * t;

    // Smootherstep: 6t^5 - 15t^4 + 10t^3
    const smooth = (t: number) => {
      const c = clamp(t, 0, 1);
      return c * c * c * (c * (c * 6 - 15) + 10);
    };

    const gridSpeeds = [35, 70, 110];

    function render(p: number) {
      // ── Parallax Background Lines ──
      for (let i = 0; i < gridLines.length; i++) {
        gridLines[i].style.transform = `translate3d(0,${-p * gridSpeeds[i]}px,0)`;
      }

      // ── Scroll Indicator (Fade on initial scroll) ──
      if (hint) {
        hint.style.opacity = String(lerp(0.6, 0, smooth(remap(p, 0.00, 0.05))));
      }

      // ──────────────────────────────────────────────────
      //  1. HERO (RIGHT-ALIGNED):
      //     • Headline lines ("come," & "Close is open."):
      //       3D flip-to-top effect on scroll-out / flip-down on scroll-in.
      //       Pivoting at the top edge and rotating upward and away (-rotateX).
      //     • Sub-line text (italic paragraph):
      //       Reverted to simpler fade and subtle upward slide (no wipe).
      //     • Tied to scroll position (scroll-scrubbed), with smooth continuous easing.
      // ──────────────────────────────────────────────────
      const flip1   = smooth(remap(p, 0.02, 0.14));
      const flip2   = smooth(remap(p, 0.04, 0.165));
      const subProg = smooth(remap(p, 0.05, 0.175));

      if (hwCome) {
        const rotX1   = -flip1 * 80;
        const transY1 = -flip1 * 26;
        const transZ1 = -flip1 * 35;
        const op1     = 1 - Math.pow(flip1, 2.2);

        hwCome.style.transform = `perspective(1200px) translate3d(0,${transY1}px,${transZ1}px) rotateX(${rotX1}deg)`;
        hwCome.style.opacity   = String(Math.max(0, op1));
      }

      if (hwClose) {
        const rotX2   = -flip2 * 80;
        const transY2 = -flip2 * 26;
        const transZ2 = -flip2 * 35;
        const op2     = 1 - Math.pow(flip2, 2.2);

        hwClose.style.transform = `perspective(1200px) translate3d(0,${transY2}px,${transZ2}px) rotateX(${rotX2}deg)`;
        hwClose.style.opacity   = String(Math.max(0, op2));
      }

      if (s1Subtext) {
        const subOp = 1 - Math.pow(subProg, 2.0);
        const subY  = -subProg * 28;

        s1Subtext.style.opacity   = String(Math.max(0, subOp));
        s1Subtext.style.transform = `translate3d(0,${subY}px,0)`;
      }

      const s1Complete = flip2 >= 0.98 && subProg >= 0.98;
      scene1!.style.pointerEvents = s1Complete ? 'none' : 'auto';

      // ──────────────────────────────────────────────────
      //  2. SERVICES GRID (2x2, LEFT-ALIGNED IN CELLS):
      //     [0.12 -> 0.24 ENTER] -> [0.24 -> 0.38 HOLD] -> [0.38 -> 0.50 EXIT]
      // ──────────────────────────────────────────────────
      const s2In   = smooth(remap(p, 0.12, 0.24));
      const s2Out  = smooth(remap(p, 0.38, 0.50));
      const s2Op   = s2In * (1 - s2Out);
      const s2Y    = (1 - s2In) * 36 - s2Out * 36;

      scene2!.style.opacity       = String(s2Op);
      scene2!.style.transform     = `translate3d(0,${s2Y}px,0)`;
      scene2!.style.pointerEvents = s2Op > 0.06 ? 'auto' : 'none';

      if (s2Grid) s2Grid.style.transform = `translate3d(0,${(1 - s2In) * 10}px,0)`;

      // ──────────────────────────────────────────────────
      //  3. BRANDHING (RIGHT-ALIGNED):
      //     [0.46 -> 0.58 ENTER] -> [0.58 -> 0.70 HOLD] -> [0.70 -> 0.80 EXIT]
      // ──────────────────────────────────────────────────
      const s3In   = smooth(remap(p, 0.46, 0.58));
      const s3Out  = smooth(remap(p, 0.70, 0.80));
      const s3Op   = s3In * (1 - s3Out);
      const s3Y    = (1 - s3In) * 36 - s3Out * 36;

      scene3!.style.opacity       = String(s3Op);
      scene3!.style.transform     = `translate3d(0,${s3Y}px,0)`;
      scene3!.style.pointerEvents = s3Op > 0.06 ? 'auto' : 'none';

      if (s3Headline) s3Headline.style.transform = `translate3d(0,${(1 - s3In) * 8}px,0)`;
      if (s3Body)     s3Body.style.transform     = `translate3d(0,${(1 - s3In) * 16}px,0)`;

      // ──────────────────────────────────────────────────
      //  4. CONTACT (LEFT-ALIGNED):
      //     [0.72 -> 0.82 ENTER] -> [0.82 -> 0.90 HOLD] -> [0.90 -> 0.96 EXIT]
      // ──────────────────────────────────────────────────
      const s4In   = smooth(remap(p, 0.72, 0.82));
      const s4Out  = smooth(remap(p, 0.90, 0.96));
      const s4Op   = s4In * (1 - s4Out);
      const s4Y    = (1 - s4In) * 36 - s4Out * 32;

      scene4!.style.opacity       = String(s4Op);
      scene4!.style.transform     = `translate3d(0,${s4Y}px,0)`;
      scene4!.style.pointerEvents = s4Op > 0.06 ? 'auto' : 'none';

      if (s4Links) s4Links.style.transform = `translate3d(0,${(1 - s4In) * 8}px,0)`;
      if (s4Sub)   s4Sub.style.transform   = `translate3d(0,${(1 - s4In) * 16}px,0)`;

      // ──────────────────────────────────────────────────
      //  5. FOOTER (WORDMARK LEFT, TWO BLOCKS CENTER-RIGHT):
      //     [0.92 -> 0.97 ENTER] -> [0.97 -> 1.00 FINAL ANCHOR HOLD]
      // ──────────────────────────────────────────────────
      const s5In   = smooth(remap(p, 0.92, 0.97));
      const s5Y    = (1 - s5In) * 32;

      scene5!.style.opacity       = String(s5In);
      scene5!.style.transform     = `translate3d(0,${s5Y}px,0)`;
      scene5!.style.pointerEvents = s5In > 0.06 ? 'auto' : 'none';

      if (s5Logo)   s5Logo.style.transform   = `translate3d(0,${(1 - s5In) * 8}px,0)`;
      if (s5Blocks) s5Blocks.style.transform = `translate3d(0,${(1 - s5In) * 14}px,0)`;
    }

    function tick(timestamp: number) {
      if (!lastTime) lastTime = timestamp;
      const dt = Math.min((timestamp - lastTime) / 1000, 0.1);
      lastTime = timestamp;

      const max = drive!.offsetHeight - window.innerHeight;
      if (max <= 0) {
        requestAnimationFrame(tick);
        return;
      }

      tgt = clamp(window.scrollY / max, 0, 1);

      const blend = 1 - Math.exp(-DAMP_RATE * dt);
      const delta = tgt - cur;

      if (Math.abs(delta) > 0.00003) {
        cur += delta * blend;
        render(cur);
        requestAnimationFrame(tick);
      } else {
        cur = tgt;
        render(cur);
        busy = false;
        lastTime = 0;
      }
    }

    function wake() {
      if (!busy) {
        busy = true;
        lastTime = 0;
        requestAnimationFrame(tick);
      }
    }

    window.addEventListener('scroll', wake, { passive: true });
    window.addEventListener('resize', wake, { passive: true });

    render(0);
  }

  rmq.addEventListener('change', () => window.location.reload());
  initScrollEngine();
</script>
