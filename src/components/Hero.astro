---
// Hero.astro
---

<main class="relative w-full h-dvh min-h-screen flex flex-col items-center justify-center px-4 sm:px-6 lg:px-8 bg-black overflow-hidden">
  <div class="flex flex-col items-center text-center max-w-7xl mx-auto z-10">
    <!-- Hero Heading Composition -->
    <h1 
      class="hero-heading font-extrabold text-white text-center tracking-tight select-none animate-fade-hero"
      style="font-size: clamp(56px, 11vw, 170px); line-height: 0.9;"
    >
      <span class="block tracking-[-0.04em]">CLOSE</span>
      <span class="block tracking-[-0.04em] mt-1 sm:mt-2 lg:mt-3">IS OPEN.</span>
    </h1>

    <!-- Supporting Text -->
    <div class="mt-8 sm:mt-12 lg:mt-16 flex items-center justify-center animate-fade-subtle opacity-80">
      <span class="supporting-text text-xs sm:text-sm lg:text-[14px] font-medium text-neutral-400 tracking-[0.35em]">
        CALICUT &bull; KERALA
      </span>
    </div>
  </div>
</main>
