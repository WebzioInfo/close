---
import Layout from '../../layouts/Layout.astro';
import { projects, type Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.map(project => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const projectIndex = projects.findIndex(p => p.slug === project.slug) + 1;
---

<Layout 
  title={`${project.title} — Close`}
  description={project.summary}
  image={project.image}
>
  <article class="min-h-screen py-16 sm:py-24 px-6 sm:px-10 lg:px-16 max-w-[1400px] mx-auto space-y-16">
    
    <!-- Breadcrumb -->
    <div class="flex items-center justify-between font-mono text-[10px] sm:text-[11px] text-neutral-500 border-b border-brand-border/40 pb-6 uppercase tracking-widest">
      <a href="/#projects" class="inline-flex items-center gap-2 text-white hover:text-neutral-300 transition-colors">
        <span>&larr; Projects</span>
      </a>
      <span>{project.category} &middot; {project.year}</span>
    </div>

    <!-- Header -->
    <header class="space-y-6 max-w-5xl">
      <div class="font-mono text-[10px] text-neutral-500 uppercase tracking-[0.3em]">
        Project No. {String(projectIndex).padStart(2, '0')}
      </div>
      <h1 class="text-editorial-hero text-white">
        {project.title}
      </h1>
      <p class="font-sans font-light text-xl sm:text-2xl text-neutral-300 leading-relaxed max-w-3xl">
        {project.subtitle}
      </p>
    </header>

    <!-- Hero image -->
    <div class="relative aspect-[21/9] w-full border border-brand-border/40 bg-brand-surface overflow-hidden">
      <img 
        src={project.image} 
        alt={project.title} 
        class="w-full h-full object-cover img-monochrome"
      />
    </div>

    <!-- Summary bar -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 py-8 border-y border-brand-border/40">
      <div>
        <span class="font-mono text-[10px] text-neutral-500 uppercase tracking-widest block mb-2">Client</span>
        <span class="font-sans text-sm text-white font-medium">{project.client}</span>
      </div>
      <div>
        <span class="font-mono text-[10px] text-neutral-500 uppercase tracking-widest block mb-2">Deliverables</span>
        <div class="font-sans text-xs text-neutral-300">
          {project.deliverables.join(' · ')}
        </div>
      </div>
      <div>
        <span class="font-mono text-[10px] text-neutral-500 uppercase tracking-widest block mb-2">Year</span>
        <span class="font-sans text-sm text-white font-medium">{project.year}</span>
      </div>
    </div>

    <!-- Narrative sections -->
    <div class="max-w-3xl mx-auto space-y-16 pt-8">
      
      <section class="space-y-4 border-l-2 border-brand-border/50 pl-6 sm:pl-8">
        <span class="font-mono text-[10px] uppercase tracking-widest text-neutral-500 block">01 — Observation</span>
        <h2 class="font-display text-2xl sm:text-3xl text-white font-medium tracking-tight">The Initial Context</h2>
        <p class="font-sans font-light text-neutral-400 text-base leading-relaxed">{project.observation}</p>
      </section>

      <section class="space-y-4 border-l-2 border-brand-border/50 pl-6 sm:pl-8">
        <span class="font-mono text-[10px] uppercase tracking-widest text-neutral-500 block">02 — Friction</span>
        <h2 class="font-display text-2xl sm:text-3xl text-white font-medium tracking-tight">What Needed Clarity</h2>
        <p class="font-sans font-light text-neutral-400 text-base leading-relaxed">{project.problem}</p>
      </section>

      <section class="space-y-4 border-l-2 border-brand-border/50 pl-6 sm:pl-8">
        <span class="font-mono text-[10px] uppercase tracking-widest text-neutral-500 block">03 — Transformation</span>
        <h2 class="font-display text-2xl sm:text-3xl text-white font-medium tracking-tight">What Changed</h2>
        <p class="font-sans font-light text-neutral-400 text-base leading-relaxed">{project.transformation}</p>
      </section>

      <section class="space-y-4 border-l-2 border-brand-border/50 pl-6 sm:pl-8">
        <span class="font-mono text-[10px] uppercase tracking-widest text-neutral-500 block">04 — Learning</span>
        <h2 class="font-display text-2xl sm:text-3xl text-white font-medium tracking-tight">What Was Learned</h2>
        <div class="bg-brand-nearblack border border-brand-border/40 p-6 sm:p-8">
          <p class="font-display text-lg sm:text-xl text-white font-medium leading-relaxed">
            "{project.learnings}"
          </p>
        </div>
      </section>

      {project.quote && (
        <blockquote class="py-8 border-y border-brand-border/40 space-y-4">
          <p class="font-display text-xl sm:text-2xl text-neutral-100 font-medium leading-snug">
            "{project.quote.text}"
          </p>
          <cite class="block font-mono text-[10px] text-neutral-500 not-italic uppercase tracking-widest">
            — {project.quote.author}
          </cite>
        </blockquote>
      )}
    </div>

    <!-- Bottom nav -->
    <div class="pt-16 border-t border-brand-border/40 flex flex-col sm:flex-row items-center justify-between font-mono text-[10px] gap-4 uppercase tracking-widest">
      <a href="/#projects" class="text-neutral-400 hover:text-white transition-colors">
        &larr; All projects
      </a>
      <a href="/#office" class="text-white hover:text-neutral-300 transition-colors">
        Start a conversation &rarr;
      </a>
    </div>

  </article>
</Layout>
